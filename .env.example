# Copy to .env and fill in real values. NEVER commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Fernet key with:        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---------- App ----------
APP_ENV=development              # development | production
APP_NAME=Calma
LOG_LEVEL=INFO

# ---------- Database (Postgres) ----------
POSTGRES_USER=calma
POSTGRES_PASSWORD=change-me      # SECRET
POSTGRES_DB=calma
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://calma:change-me@db:5432/calma   # SECRET (contains password)

# ---------- Auth ----------
JWT_SECRET_KEY=                  # SECRET – long random string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Encryption of answers at rest ----------
ENCRYPTION_KEY=                  # SECRET – Fernet key. Losing it = losing stored answers. Back it up.

# ---------- Seed admin (first run only) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                  # SECRET

# ---------- CORS / URLs ----------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1   # NOT secret (exposed to browser)

# ---------- ML ----------
MODEL_PATH=/app/ml_models/composite_v1.joblib
MODEL_VERSION=composite_v1

# ---------- Optional ----------
# Email reminders (re-test every 2 weeks)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                   # SECRET
EMAIL_FROM=no-reply@example.com
# Error monitoring
SENTRY_DSN=                      # SECRET-ish
